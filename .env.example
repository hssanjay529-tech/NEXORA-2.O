# NEXORA Environment Configuration
PROJECT_NAME="NEXORA — College Management Portal"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_USER=nexora_admin
POSTGRES_PASSWORD=nexora_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexora
DATABASE_URL=postgresql+psycopg2://nexora_admin:nexora_password@localhost:5432/nexora

# Security & JWT Configuration
SECRET_KEY=nexora-insecure-secret-key-change-in-production-2026-secure-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Multi-Tenancy
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
